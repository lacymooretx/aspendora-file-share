@page "/r/{ShortId}"
@page "/request/{ShortId}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AspendoraFileShare.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Context
@inject NavigationManager Navigation

<PageTitle>@(isLoading ? "Loading..." : "Upload Files") - Aspendora File Share</PageTitle>

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white border-b-2 border-[#660000] shadow-sm">
        <div class="max-w-4xl mx-auto px-6 py-4">
            <div class="flex items-center justify-center">
                <img src="/aspendora-logo.png" alt="Aspendora" class="h-16" />
            </div>
            <h1 class="text-center text-2xl font-bold text-[#660000] mt-2">Aspendora File Share</h1>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6 py-8">
        @if (isLoading)
        {
            <div class="bg-white border-2 border-[#660000] rounded-lg p-8 text-center">
                <div class="inline-block">
                    <svg class="spinner w-12 h-12 text-[#660000]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
                <p class="text-gray-600 mt-4">Loading request...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="bg-white border-2 border-red-500 rounded-lg p-8 text-center">
                <svg class="w-16 h-16 text-red-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <h2 class="text-2xl font-bold text-red-600 mt-4">Error</h2>
                <p class="text-gray-600 mt-2">@errorMessage</p>
            </div>
        }
        else if (isUnavailable)
        {
            <div class="bg-white border-2 border-[#660000] rounded-lg p-8 text-center">
                <svg class="w-16 h-16 text-gray-400 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h2 class="text-2xl font-bold text-[#660000] mt-4">@unavailableTitle</h2>
                <p class="text-gray-600 mt-2">@unavailableMessage</p>
                <p class="text-gray-500 text-sm mt-4">Please contact @requesterName to request a new link.</p>
            </div>
        }
        else if (uploadComplete)
        {
            <div class="bg-white border-2 border-[#660000] rounded-lg p-8 text-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto">
                    <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-[#660000] mt-4">Files Sent!</h2>
                <p class="text-gray-600 mt-2">Thank you. @requesterName has been notified that your files were uploaded.</p>
                <button @onclick="UploadMore"
                        class="mt-6 px-6 py-2 bg-[#660000] text-white rounded-lg hover:bg-black transition-colors">
                    Upload More Files
                </button>
            </div>
        }
        else
        {
            <!-- Request Info -->
            <div class="bg-white border-2 border-[#660000] rounded-lg p-6 mb-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-[#660000] rounded-full flex items-center justify-center text-white font-bold text-xl">
                        @(requesterName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-gray-900">
                            @requesterName is requesting files from you
                        </h2>
                        <p class="text-sm text-gray-500">
                            Requested on @createdAt.ToLocalTime().ToString("MMMM dd, yyyy")
                        </p>
                    </div>
                </div>

                <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <p class="text-gray-900 font-semibold">@title</p>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <p class="text-gray-700 whitespace-pre-wrap mt-2">@message</p>
                    }
                </div>
            </div>

            <!-- Submitter Info (optional) -->
            <div class="bg-white border-2 border-[#660000] rounded-lg p-6 mb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Your Details <span class="text-sm font-normal text-gray-500">(optional)</span></h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
                        <input type="text" @bind="submitterName" @bind:event="oninput"
                               placeholder="Jane Doe"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#660000] focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Your Email</label>
                        <input type="email" @bind="submitterEmail" @bind:event="oninput"
                               placeholder="jane@example.com"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#660000] focus:border-transparent" />
                    </div>
                </div>
            </div>

            <!-- Uploader -->
            <FileRequestUpload ShortId="@ShortId"
                               SubmitterName="@submitterName"
                               SubmitterEmail="@submitterEmail"
                               OnUploadComplete="HandleUploadComplete" />

            <div class="mt-4 flex items-center justify-center gap-2 text-sm text-gray-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>This request expires @expiresAt.ToLocalTime().ToString("MMMM dd, yyyy")</span>
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="max-w-4xl mx-auto px-6 py-8 text-center text-sm text-gray-500">
        <p>&copy; @DateTime.Now.Year Aspendora Technologies. All rights reserved.</p>
    </footer>
</div>

@code {
    [Parameter]
    public string ShortId { get; set; } = null!;

    private bool isLoading = true;
    private string? errorMessage;

    private bool isUnavailable = false;
    private string unavailableTitle = "";
    private string unavailableMessage = "";

    private bool uploadComplete = false;

    private string? requesterName;
    private string title = "";
    private string? message;
    private DateTime createdAt;
    private DateTime expiresAt;

    private string submitterName = "";
    private string submitterEmail = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var fileRequest = await Context.FileRequests
                .Include(r => r.User)
                .FirstOrDefaultAsync(r => r.ShortId == ShortId);

            if (fileRequest == null || fileRequest.Deleted)
            {
                errorMessage = "This file request was not found. It may have been deleted or never existed.";
                return;
            }

            requesterName = fileRequest.User?.Name ?? fileRequest.User?.Email ?? "Someone";
            title = fileRequest.Title;
            message = fileRequest.Message;
            createdAt = fileRequest.CreatedAt;
            expiresAt = fileRequest.ExpiresAt;

            if (fileRequest.Closed)
            {
                isUnavailable = true;
                unavailableTitle = "Request Closed";
                unavailableMessage = "This file request is no longer accepting uploads.";
            }
            else if (fileRequest.ExpiresAt < DateTime.UtcNow)
            {
                isUnavailable = true;
                unavailableTitle = "Request Expired";
                unavailableMessage = "This file request has expired and is no longer accepting uploads.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading file request: {ex.Message}");
            errorMessage = "Failed to load this request. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task HandleUploadComplete(FileRequestUpload.UploadResult result)
    {
        if (result.Success)
        {
            uploadComplete = true;
        }
        return Task.CompletedTask;
    }

    private void UploadMore()
    {
        uploadComplete = false;
    }
}
